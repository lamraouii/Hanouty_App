<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <!-- Section supérieure avec fond marron -->
    <RelativeLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/rounded_maron_bg"
        android:gravity="center">

        <!-- Image du motif marocain -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.1"
            android:scaleType="centerCrop"
            android:src="@drawable/rounded_pattern_bg" />

        <!-- Logo Store dans cercle -->
        <RelativeLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_icon_bg" />

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_store"
                android:contentDescription="@string/app_name"
                app:tint="@color/maron" />
        </RelativeLayout>
    </RelativeLayout>

    <!-- Contenu principal avec ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topSection"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ahlaaan !"
                android:textSize="28sp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="8dp" />

            <!-- Sous-titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connectez-vous pour gérer votre hanout"
                android:textSize="13sp"
                android:textColor="@color/hanouty_text_secondary"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Champ Téléphone -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/hanouty_text_secondary"
                app:shapeAppearanceOverlay="@style/RoundedInputStyle"
                app:hintEnabled="false"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/phoneEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Numéro de téléphone"
                    android:inputType="phone"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/hanouty_text_secondary"
                    android:paddingVertical="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Champ Mot de passe -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/hanouty_text_secondary"
                app:endIconMode="password_toggle"
                app:shapeAppearanceOverlay="@style/RoundedInputStyle"
                app:hintEnabled="false"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mot de passe"
                    android:inputType="textPassword"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/hanouty_text_secondary"
                    android:paddingVertical="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mot de passe oublié -->
            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Mot de passe oublié ?"
                android:textColor="@color/maron"
                android:fontFamily="@font/poppins"
                android:textSize="13sp"
                android:paddingEnd="4dp"
                android:paddingStart="4dp"
                android:layout_marginBottom="32dp" />

            <!-- Bouton Connexion -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_maron_bg"
                android:paddingVertical="16dp"
                android:text="Se Connecter"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

            <!-- Bouton Inscription -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/inscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_border"
                android:paddingVertical="16dp"
                android:text="Inscription"
                android:textColor="@color/moroccan_green_button"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>