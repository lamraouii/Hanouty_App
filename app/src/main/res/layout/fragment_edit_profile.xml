<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <!-- Section supérieure avec fond marron (Reduced height for inner page) -->
    <RelativeLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/rounded_maron_bg"
        android:gravity="center">

        <!-- Image du motif marocain -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.1"
            android:scaleType="centerCrop"
            android:src="@drawable/rounded_pattern_bg" />

        <!-- Logo Store dans cercle -->
        <RelativeLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_icon_bg" />

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_profile_maron"
                android:contentDescription="@string/app_name"
                app:tint="@color/maron" />
        </RelativeLayout>
        
        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="51dp"
            android:layout_height="55dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="33dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/white" />
            
    </RelativeLayout>

    <!-- Contenu principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topSection"
        android:layout_marginTop="-40dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">
            
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Titre -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modifier le profil"
                        android:textSize="24sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_gravity="center"
                        android:layout_marginBottom="24dp" />

                    <!-- Champ Nom -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="@color/background_cream"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/hanouty_text_secondary"
                        app:shapeAppearanceOverlay="@style/RoundedInputStyle"
                        app:hintEnabled="false"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nom complet"
                            android:inputType="textPersonName"
                            android:fontFamily="@font/poppins"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/hanouty_text_secondary"
                            android:paddingVertical="14dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Champ Téléphone -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="@color/background_cream"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:startIconTint="@color/hanouty_text_secondary"
                        app:shapeAppearanceOverlay="@style/RoundedInputStyle"
                        app:hintEnabled="false"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_marginBottom="24dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Numéro de téléphone"
                            android:inputType="phone"
                            android:fontFamily="@font/poppins"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/hanouty_text_secondary"
                            android:paddingVertical="14dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Divider for Password Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/hanouty_text_secondary"
                            android:alpha="0.2"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sécurité"
                            android:textSize="12sp"
                            android:textColor="@color/hanouty_text_secondary"
                            android:fontFamily="@font/poppins"
                            android:layout_marginHorizontal="8dp"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/hanouty_text_secondary"
                            android:alpha="0.2"/>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="@color/background_cream"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/hanouty_text_secondary"
                        app:endIconMode="password_toggle"
                        app:shapeAppearanceOverlay="@style/RoundedInputStyle"
                        app:hintEnabled="false"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_marginBottom="24dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCurrentPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Mot de passe actuel (requis)"
                            android:inputType="textPassword"
                            android:fontFamily="@font/poppins"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/hanouty_text_secondary"
                            android:paddingVertical="14dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nouveau Mot de passe -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="@color/background_cream"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:startIconDrawable="@drawable/ic_key"
                        app:startIconTint="@color/hanouty_text_secondary"
                        app:endIconMode="password_toggle"
                        app:shapeAppearanceOverlay="@style/RoundedInputStyle"
                        app:hintEnabled="false"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:hint="Nouveau mot de passe (optionnel)"
                            android:inputType="textPassword"
                            android:paddingVertical="14dp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/hanouty_text_secondary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>



                    <!-- Bouton Enregistrer -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_maron_bg"
                        android:paddingVertical="16dp"
                        android:text="Enregistrer"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textAllCaps="false" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
