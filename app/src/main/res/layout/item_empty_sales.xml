<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:alpha="0.6"> <ImageView
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:src="@drawable/ic_cart"
    app:tint="@color/hanouty_text_secondary"
    android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pas encore de ventes"
        android:textColor="@color/hanouty_text_secondary"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_semibold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Commencez à vendre pour voir l'historique ici"
        android:textColor="@color/hanouty_text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="4dp"/>

</LinearLayout>